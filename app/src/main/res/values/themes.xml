<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      DayNight：跟随系统深浅色。用户也可以在 App 里手动锁定浅色/深色
      （见 Prefs.themeMode 与 App.applyTheme()）。
      具体色值在两套 colors.xml 里：values/ 是浅色，values-night/ 是深色。
    -->
    <style name="Theme.App" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_surface</item>

        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline</item>

        <item name="colorError">@color/danger</item>
        <item name="colorOnError">@color/on_primary</item>

        <item name="android:colorBackground">@color/bg</item>
        <item name="colorOnBackground">@color/on_surface</item>

        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>

        <!-- 系统栏图标的明暗由 light_system_bars 决定，浅色/深色各一份 -->
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">
            @bool/light_system_bars
        </item>

        <item name="android:textColorPrimary">@color/on_surface</item>
        <item name="android:textColorSecondary">@color/on_surface_variant</item>
        <item name="android:textColorHint">@color/on_surface_faint</item>

        <!-- 滑块的轨道/滑块尺寸在 UiKit.slider() 里用代码设置（属性名版本差异大） -->
        <item name="materialSwitchStyle">@style/Widget.Material3.CompoundButton.MaterialSwitch</item>
    </style>

    <style name="Text.Hero" parent="">
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Text.SectionTitle" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.RowTitle" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="Text.RowSubtitle" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Text.Caption" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/on_surface_faint</item>
    </style>

    <style name="Text.Mono" parent="">
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/code_fg</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
</resources>
